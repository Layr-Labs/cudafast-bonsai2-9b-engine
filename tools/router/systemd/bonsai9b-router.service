[Unit]
Description=Bonsai 2 9B CUDA submission router

[Service]
Type=simple
WorkingDirectory=@REPO@
Environment="PATH=@PATH@"
ExecStart=/usr/bin/systemd-inhibit --what=sleep:idle --who=bonsai9b-router "--why=Submission routing" /usr/bin/python3 -u "@EXEC_REPO@/tools/router/router.py" run
Restart=on-failure
RestartSec=30
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
